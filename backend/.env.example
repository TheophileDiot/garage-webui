# Browser-facing Vite development origin; the backend still listens on port 3909.
# For a standalone binary, set PUBLIC_URL to its browser-facing origin.
PUBLIC_URL=http://localhost:5173
BASE_PATH=
API_BASE_URL=http://localhost:3903
API_ADMIN_KEY=
S3_ENDPOINT_URL=http://localhost:3900
S3_REGION=garage
# Configure local bcrypt authentication OR all four OIDC settings.
AUTH_USER_PASS=
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ALLOWED_GROUPS=
TZ=Europe/Paris

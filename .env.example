# Compose settings. Copy to .env and fill credentials locally; never commit it.
PUBLIC_URL=https://garage-ui.example.com
LISTEN_IP=127.0.0.1
PORT=3909
BASE_PATH=
GARAGE_NETWORK=garage-net
API_BASE_URL=http://garage:3903
API_ADMIN_KEY=
S3_ENDPOINT_URL=http://garage:3900
S3_REGION=garage
# Choose local bcrypt login OR all four OIDC values. OIDC takes precedence.
AUTH_USER_PASS=
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ALLOWED_GROUPS=
# Frontend development proxy (no credentials belong in VITE_ variables).
VITE_API_URL=http://localhost:3909

{
  "name": "garage-webui",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev:client": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:server": "cd backend && go run .",
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "typecheck": "tsc -b",
    "test": "node --test \"src/**/*.test.ts\"",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@tanstack/react-query": "^5.105.3",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dayjs": "^1.11.23",
    "lucide-react": "^0.427.0",
    "mime": "^4.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.5",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.1",
    "zod": "^4.6.7",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "autoprefixer": "^10.6.2",
    "concurrently": "^8.2.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "postcss": "^8.5.32",
    "prettier": "3.9.10",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild"
    ],
    "overrides": {
      "eslint-plugin-react-hooks>zod": "4.6.7",
      "yaml@<2.8.3": "^2.8.3"
    }
  },
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24.22.2"
  }
}
